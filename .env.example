# Named environment used by the UI framework.
TEST_ENV=test

# Non-secret target URLs.
BASE_URL=https://example.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# Enterprise tier URLs are required only when that tier is selected.
DEV_BASE_URL=
QA_BASE_URL=
INT_BASE_URL=
SIT_BASE_URL=
UAT_BASE_URL=
PREPROD_BASE_URL=
PROD_BASE_URL=
DEV_API_BASE_URL=
QA_API_BASE_URL=
INT_API_BASE_URL=
SIT_API_BASE_URL=
UAT_API_BASE_URL=
PREPROD_API_BASE_URL=
PROD_API_BASE_URL=

# Live example execution is opt-in.
RUN_PLAYWRIGHT_SMOKE=false
RUN_API_TESTS=false

# Supply credentials through the runtime secret store, never this file.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
API_TOKEN=
