{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qe-platform:test-cases:1.1.0",
  "title": "Standard Test Cases",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "version", "title", "priority", "scenarioType", "preconditions", "steps", "expectedResult", "traceability", "status"],
    "properties": {
      "id": { "type": "string", "pattern": "^TC-[1-9][0-9]*$" },
      "version": { "type": "integer", "minimum": 1 },
      "title": { "type": "string", "minLength": 1 },
      "priority": { "enum": ["critical", "high", "medium", "low"] },
      "scenarioType": { "enum": ["functional", "negative", "boundary", "risk", "validation", "authorization", "security", "integration", "regression"] },
      "preconditions": { "type": "array", "items": { "type": "string" } },
      "steps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["sequence", "action", "expectedOutcome"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 1 },
            "action": { "type": "string", "minLength": 1 },
            "expectedOutcome": { "type": "string", "minLength": 1 }
          }
        }
      },
      "expectedResult": { "type": "string", "minLength": 1 },
      "repositorySections": { "type": "array", "uniqueItems": true, "items": { "enum": ["UI", "API", "Performance"] } },
      "traceability": {
        "type": "object",
        "required": ["storyKey", "acceptanceCriteriaIds", "scenarioIds", "codeReferences"],
        "properties": {
          "storyKey": { "type": "string" },
          "acceptanceCriteriaIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "scenarioIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "apiOperationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "historicalIssueKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "adrIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "evidenceConfidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "testDataSetIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "codeReferences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mappingId", "acceptanceCriteriaId", "changeType", "changeAreas", "repository", "branch", "commit", "filePath", "changeSummary"],
              "properties": {
                "mappingId": { "type": "string", "pattern": "^RCM-[1-9][0-9]*$" },
                "acceptanceCriteriaId": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" },
                "changeType": { "enum": ["added", "modified", "deleted"] },
                "changeAreas": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["business-logic", "service", "api", "validation", "database", "ui", "ui-component", "error-handling", "other"] } },
                "repository": { "type": "string", "minLength": 1 },
                "branch": { "type": "string", "minLength": 1 },
                "pullRequest": { "type": "string", "minLength": 1 },
                "commit": { "type": "string", "minLength": 1 },
                "filePath": { "type": "string", "minLength": 1 },
                "changeSummary": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "status": { "enum": ["draft", "approved", "deprecated"] }
    }
  }
}
