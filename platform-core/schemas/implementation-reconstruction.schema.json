{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qe-platform:implementation-reconstruction:1.0.0",
  "title": "Implementation Reconstruction Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyKey", "repository", "sourceKind", "sourceShas", "status", "changes", "addedFiles", "modifiedFiles", "deletedFiles", "apiChanges", "uiComponentChanges", "businessLogicChanges", "validationChanges", "dataAccessChanges", "errorHandlingChanges", "unresolvedFiles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "storyKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
    "repository": { "type": "string", "minLength": 1 },
    "sourceKind": { "enum": ["feature-branch", "pull-request", "merge-commit", "commit-history", "repository-diff"] },
    "sourceShas": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["complete", "partial"] },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "addedFiles": { "$ref": "#/$defs/paths" },
    "modifiedFiles": { "$ref": "#/$defs/paths" },
    "deletedFiles": { "$ref": "#/$defs/paths" },
    "apiChanges": { "$ref": "#/$defs/changes" },
    "uiComponentChanges": { "$ref": "#/$defs/changes" },
    "businessLogicChanges": { "$ref": "#/$defs/changes" },
    "validationChanges": { "$ref": "#/$defs/changes" },
    "dataAccessChanges": { "$ref": "#/$defs/changes" },
    "errorHandlingChanges": { "$ref": "#/$defs/changes" },
    "unresolvedFiles": { "$ref": "#/$defs/paths" }
  },
  "$defs": {
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "changeType", "commitShas", "areas", "symbols", "summary", "confidence", "evidenceReferences"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "changeType": { "enum": ["added", "modified", "deleted"] },
        "commitShas": { "type": "array", "items": { "type": "string" } },
        "areas": { "type": "array", "minItems": 1, "items": { "enum": ["api", "ui-component", "business-logic", "validation", "data-access", "error-handling", "other"] } },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceReferences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}