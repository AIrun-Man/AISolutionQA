{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qe-platform:xray-test-links:1.0.0",
  "title": "Imported Xray Test Issue Links",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["storyKey", "xrayTestId", "generatedTestCaseId", "jiraIssueKey", "jiraIssueUrl", "xrayRepositoryPath"],
    "properties": {
      "storyKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
      "xrayTestId": { "type": "string", "pattern": "^\\[[A-Z][A-Z0-9]+-[1-9][0-9]*\\]\\[AI-[0-9]{2,}\\]$" },
      "generatedTestCaseId": { "type": "string", "pattern": "^TC-[1-9][0-9]*$" },
      "jiraIssueKey": { "type": "string", "minLength": 1 },
      "jiraIssueUrl": { "type": "string", "format": "uri" },
      "xrayRepositoryPath": { "type": "string", "minLength": 1 }
    }
  }
}
