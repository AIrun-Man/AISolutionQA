{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qe-platform:requirement-analysis:1.0.0",
  "title": "Requirement Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "story", "acceptanceCriteria", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "analysisId": { "type": "string", "minLength": 1 },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "summary", "description"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "functionalRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "acceptanceCriteriaIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^FR-[1-9][0-9]*$" },
          "description": { "type": "string", "minLength": 1 },
          "acceptanceCriteriaIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" }
          }
        }
      }
    },
    "businessRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "acceptanceCriteriaIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^BR-[1-9][0-9]*$" },
          "description": { "type": "string", "minLength": 1 },
          "acceptanceCriteriaIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" }
          }
        }
      }
    },
    "nonFunctionalRequirements": {
      "$ref": "#/$defs/requirementStatements"
    },
    "validationRules": {
      "$ref": "#/$defs/requirementStatements"
    },
    "implicitRequirements": {
      "$ref": "#/$defs/requirementStatements"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^ASM-[1-9][0-9]*$" },
          "description": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "rationale", "priority", "acceptanceCriteriaIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^RISK-[1-9][0-9]*$" },
          "description": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["critical", "high", "medium", "low"] },
          "acceptanceCriteriaIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" }
          }
        }
      }
    },
    "automationCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenarioId", "acceptanceCriteriaIds", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^AUT-CAND-[1-9][0-9]*$" },
          "scenarioId": { "type": "string", "pattern": "^(FS|NS|BS|RS|VS|AUTH|SS|INT|GS)-[1-9][0-9]*$" },
          "acceptanceCriteriaIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" }
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "jiraContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUrl", "retrievedAt", "metadata", "linkedDefects", "commentReferences"],
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "linkedDefects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "summary", "status"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          }
        },
        "commentReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "relatedIssues": {
          "type": "array",
          "items": { "$ref": "#/$defs/jiraRelatedIssue" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "objective", "priority", "preconditions", "steps", "expectedResult", "acceptanceCriteriaIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^(FS|NS|BS|RS|VS|AUTH|SS|INT|GS)-[1-9][0-9]*$" },
          "category": { "enum": ["functional", "negative", "boundary", "risk", "validation", "authorization", "security", "integration", "regression"] },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["critical", "high", "medium", "low"] },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sequence", "action", "expectedOutcome"],
              "properties": {
                "sequence": { "type": "integer", "minimum": 1 },
                "action": { "type": "string", "minLength": 1 },
                "expectedOutcome": { "type": "string", "minLength": 1 }
              }
            }
          },
          "expectedResult": { "type": "string", "minLength": 1 },
          "acceptanceCriteriaIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" }
          }
        }
      }
    }
  },
  "$defs": {
    "jiraRelatedIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "summary", "status", "relationship"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "relationship": { "enum": ["linked-story", "parent-story", "child-story", "epic", "enhancement", "defect"] },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "requirementStatements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "acceptanceCriteriaIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^(NFR|VR|IR)-[1-9][0-9]*$" },
          "description": { "type": "string", "minLength": 1 },
          "acceptanceCriteriaIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" }
          }
        }
      }
    }
  }
}
