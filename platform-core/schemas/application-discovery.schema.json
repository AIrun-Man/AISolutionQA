{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qe-platform:application-discovery:1.0.0",
  "title": "Application Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "applicationId", "applicationName", "baseUrl", "pages", "navigationPaths"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "applicationId": { "type": "string", "minLength": 1 },
    "applicationName": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "route", "status", "menus", "forms", "tables", "buttons", "validations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "route": { "type": "string" },
          "status": { "enum": ["discovered", "partial", "needs-review"] },
          "menus": { "type": "array" },
          "forms": { "type": "array" },
          "tables": { "type": "array" },
          "buttons": { "type": "array" },
          "validations": { "type": "array" },
          "dialogs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "visible", "enabled", "title", "dismissButtonIds"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "visible": { "type": "boolean" },
                "enabled": { "type": "boolean" },
                "title": { "type": "string", "minLength": 1 },
                "dismissButtonIds": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "navigationPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourcePageId", "targetPageId", "triggerElementId", "conditions"],
        "properties": {
          "id": { "type": "string" },
          "sourcePageId": { "type": "string" },
          "targetPageId": { "type": "string" },
          "triggerElementId": { "type": "string" },
          "conditions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "featureBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "requirementIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "journeyIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "journeyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "userJourneys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "requirementIds", "pageIds", "navigationPathIds", "outcome"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "pageIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "navigationPathIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "outcome": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
