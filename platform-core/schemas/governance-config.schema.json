{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qe-platform:governance-config:1.0.0",
  "title": "Enterprise Governance Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirementGuardrails", "testGenerationGuardrails", "automationGuardrails", "performanceGuardrails", "hallucinationGuardrails", "privacyGuardrails", "qualityGates"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requirementGuardrails": { "type": "object", "additionalProperties": false, "required": ["minimumConfidence", "minimumAcceptanceCriteria", "minimumBusinessRules", "maximumAmbiguousAcceptanceCriteria", "duplicateStoryConfidenceThreshold", "requiredBusinessContextFields", "ambiguityPatterns", "blockMissingDependencies"], "properties": { "minimumConfidence": { "$ref": "#/$defs/percent" }, "minimumAcceptanceCriteria": { "$ref": "#/$defs/count" }, "minimumBusinessRules": { "$ref": "#/$defs/count" }, "maximumAmbiguousAcceptanceCriteria": { "$ref": "#/$defs/count" }, "duplicateStoryConfidenceThreshold": { "$ref": "#/$defs/percent" }, "requiredBusinessContextFields": { "$ref": "#/$defs/strings" }, "ambiguityPatterns": { "$ref": "#/$defs/strings" }, "blockMissingDependencies": { "type": "boolean" } } },
    "testGenerationGuardrails": { "type": "object", "additionalProperties": false, "required": ["minimumCoveragePercent", "minimumRiskCoveragePercent", "minimumExpectedResultLength", "minimumAssertionReferences", "detectDuplicateTests", "detectDuplicateScenarios", "requireValidUserJourneys", "blockRedundantCoverage"], "properties": { "minimumCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumRiskCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumExpectedResultLength": { "$ref": "#/$defs/count" }, "minimumAssertionReferences": { "$ref": "#/$defs/count" }, "detectDuplicateTests": { "type": "boolean" }, "detectDuplicateScenarios": { "type": "boolean" }, "requireValidUserJourneys": { "type": "boolean" }, "blockRedundantCoverage": { "type": "boolean" } } },
    "automationGuardrails": { "type": "object", "additionalProperties": false, "required": ["requireFrameworkCompliance", "requirePageObjects", "requireUtilityReuse", "requireAssertions", "requireTestTraceability", "detectDuplicateLocators", "detectDuplicateScripts", "duplicateLocatorSeverity", "namingPattern", "frameworkComplianceMarkers", "minimumAssertionCount", "prohibitedPatterns"], "properties": { "requireFrameworkCompliance": { "type": "boolean" }, "requirePageObjects": { "type": "boolean" }, "requireUtilityReuse": { "type": "boolean" }, "requireAssertions": { "type": "boolean" }, "requireTestTraceability": { "type": "boolean" }, "detectDuplicateLocators": { "type": "boolean" }, "detectDuplicateScripts": { "type": "boolean" }, "duplicateLocatorSeverity": { "enum": ["info", "warning", "critical"] }, "namingPattern": { "type": "string", "minLength": 1 }, "frameworkComplianceMarkers": { "$ref": "#/$defs/strings" }, "minimumAssertionCount": { "$ref": "#/$defs/count" }, "prohibitedPatterns": { "type": "array", "items": { "$ref": "#/$defs/patternRule" } } } },
    "performanceGuardrails": { "type": "object", "additionalProperties": false, "required": ["enabled", "blockProduction", "maximumUsers", "maximumDurationSeconds", "maximumRampRate", "maximumRequestRate", "maximumTestSize", "maximumParallelExecutions", "allowedEnvironments"], "properties": { "enabled": { "type": "boolean" }, "blockProduction": { "type": "boolean" }, "maximumUsers": { "$ref": "#/$defs/count" }, "maximumDurationSeconds": { "$ref": "#/$defs/count" }, "maximumRampRate": { "type": "number", "minimum": 0 }, "maximumRequestRate": { "type": "number", "minimum": 0 }, "maximumTestSize": { "$ref": "#/$defs/count" }, "maximumParallelExecutions": { "$ref": "#/$defs/count" }, "allowedEnvironments": { "$ref": "#/$defs/strings" } } },
    "hallucinationGuardrails": { "type": "object", "additionalProperties": false, "required": ["blockUnknownReferences", "minimumEvidenceReferences", "blockUnsupportedBusinessRules"], "properties": { "blockUnknownReferences": { "type": "boolean" }, "minimumEvidenceReferences": { "$ref": "#/$defs/count" }, "blockUnsupportedBusinessRules": { "type": "boolean" } } },
    "privacyGuardrails": { "type": "object", "additionalProperties": false, "required": ["defaultAction", "blockProductionData", "allowSyntheticData", "replacementText", "patterns"], "properties": { "defaultAction": { "enum": ["mask", "replace", "block", "synthetic-data"] }, "blockProductionData": { "type": "boolean" }, "allowSyntheticData": { "type": "boolean" }, "replacementText": { "type": "string" }, "patterns": { "type": "array", "items": { "$ref": "#/$defs/privacyPattern" } } } },
    "qualityGates": { "type": "object", "additionalProperties": false, "required": ["minimumRequirementConfidence", "minimumCoveragePercent", "minimumAcceptanceCriteriaCoveragePercent", "minimumCriticalRequirementCoveragePercent", "minimumHighRiskCodeCoveragePercent", "minimumApiCoveragePercent", "minimumContractCoveragePercent", "minimumCriticalApiCoveragePercent", "minimumAuthenticationCoveragePercent", "minimumHighRiskApiCoveragePercent", "minimumReadinessScore", "blockDuplicateTests", "blockHallucinations", "blockSecurityViolations", "blockPrivacyViolations", "blockCriticalFindings", "warningsBlockExecution"], "properties": { "minimumRequirementConfidence": { "$ref": "#/$defs/percent" }, "minimumCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumAcceptanceCriteriaCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumCriticalRequirementCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumHighRiskCodeCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumApiCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumContractCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumCriticalApiCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumAuthenticationCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumHighRiskApiCoveragePercent": { "$ref": "#/$defs/percent" }, "minimumReadinessScore": { "$ref": "#/$defs/percent" }, "blockDuplicateTests": { "type": "boolean" }, "blockHallucinations": { "type": "boolean" }, "blockSecurityViolations": { "type": "boolean" }, "blockPrivacyViolations": { "type": "boolean" }, "blockCriticalFindings": { "type": "boolean" }, "warningsBlockExecution": { "type": "boolean" }, "implementationTrust": { "type": "object", "additionalProperties": false, "required": ["minimumScore", "blockAmbiguousSources", "blockUnrelatedCommits", "blockInvalidMergeCommits", "blockIncorrectBranchMappings"], "properties": { "minimumScore": { "$ref": "#/$defs/percent" }, "blockAmbiguousSources": { "type": "boolean" }, "blockUnrelatedCommits": { "type": "boolean" }, "blockInvalidMergeCommits": { "type": "boolean" }, "blockIncorrectBranchMappings": { "type": "boolean" } } } } }
  },
  "$defs": {
    "percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "count": { "type": "integer", "minimum": 0 },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "patternRule": { "type": "object", "additionalProperties": false, "required": ["id", "pattern", "description", "severity"], "properties": { "id": { "type": "string" }, "pattern": { "type": "string" }, "description": { "type": "string" }, "severity": { "enum": ["info", "warning", "critical"] } } },
    "privacyPattern": { "type": "object", "additionalProperties": false, "required": ["id", "category", "pattern", "action", "severity"], "properties": { "id": { "type": "string" }, "category": { "type": "string" }, "pattern": { "type": "string" }, "action": { "enum": ["mask", "replace", "block", "synthetic-data"] }, "severity": { "enum": ["info", "warning", "critical"] } } }
  }
}