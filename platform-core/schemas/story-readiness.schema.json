{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qe-platform:story-readiness:1.0.0",
  "title": "Story Readiness Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyKey", "assessedBeforeExecution", "minimumOverallReadinessScore", "ready", "dimensions", "overallReadinessScore", "formula"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "storyKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
    "assessedBeforeExecution": { "const": true },
    "minimumOverallReadinessScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "ready": { "type": "boolean" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementConfidence", "implementationConfidence", "apiConfidence", "xrayCoverageConfidence", "automationConfidence"],
      "properties": {
        "requirementConfidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "implementationConfidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "apiConfidence": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
        "xrayCoverageConfidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "automationConfidence": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "overallReadinessScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "formula": { "type": "string", "minLength": 1 }
  }
}