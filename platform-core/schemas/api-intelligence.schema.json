{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qe-platform:api-intelligence:1.0.0",
  "title": "API Intelligence Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyKey", "discovery", "discoveredOperations", "requirementToApi", "apiToCode", "risks", "xrayTestCases", "automationPlan", "coverageRows", "coverage", "gaps", "governance", "executiveMetrics"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "storyKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
    "discovery": { "type": "object", "required": ["portals", "duplicateOperationIds", "errors"], "properties": { "portals": { "type": "array", "items": { "type": "object" } }, "duplicateOperationIds": { "type": "array", "items": { "type": "string" } }, "errors": { "type": "array", "items": { "type": "string" } } } },
    "discoveredOperations": { "type": "array", "items": { "type": "object", "required": ["operationId", "method", "path", "summary", "sourceUrl", "sourceType", "authentication", "expectedStatuses", "errorResponses"], "properties": { "operationId": { "type": "string" }, "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] }, "path": { "type": "string" }, "summary": { "type": "string" }, "sourceUrl": { "type": "string", "format": "uri" }, "sourceType": { "enum": ["openapi", "swagger", "redoc", "oneapi", "api-framework"] }, "authentication": { "enum": ["none", "bearer", "api-key", "basic", "oauth2", "other"] }, "securityScopes": { "type": "array", "items": { "type": "string" } }, "expectedStatuses": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 } }, "errorResponses": { "type": "array", "items": { "type": "object" } } } } },
    "requirementToApi": { "type": "array", "items": { "type": "object", "required": ["requirementId", "acceptanceCriteriaIds", "operationIds", "covered"], "properties": { "requirementId": { "type": "string" }, "acceptanceCriteriaIds": { "type": "array", "items": { "type": "string" } }, "operationIds": { "type": "array", "items": { "type": "string" } }, "covered": { "type": "boolean" } } } },
    "apiToCode": { "type": "array", "items": { "type": "object", "required": ["operationId", "repository", "branch", "commit", "controllerFiles", "serviceFiles", "businessLogicFiles", "validationFiles", "mapped"], "properties": { "operationId": { "type": "string" }, "repository": { "type": "string" }, "branch": { "type": "string" }, "commit": { "type": "string" }, "pullRequest": { "type": "string" }, "controllerFiles": { "type": "array", "items": { "type": "string" } }, "serviceFiles": { "type": "array", "items": { "type": "string" } }, "businessLogicFiles": { "type": "array", "items": { "type": "string" } }, "validationFiles": { "type": "array", "items": { "type": "string" } }, "mapped": { "type": "boolean" } } } },
    "risks": { "type": "array", "items": { "type": "object", "required": ["operationId", "level", "reasons", "recommendations"], "properties": { "operationId": { "type": "string" }, "level": { "enum": ["critical", "high", "medium", "low"] }, "reasons": { "type": "array", "items": { "type": "string" } }, "recommendations": { "type": "array", "items": { "type": "string" } } } } },
    "xrayTestCases": { "type": "array", "items": { "type": "object", "required": ["id", "operationId", "implementationReferences", "category", "summary", "objective", "preconditions", "sourceRequirement", "expectedOutcome", "action", "data", "expectedResult"], "properties": { "id": { "type": "string", "pattern": "^\\[[A-Z][A-Z0-9]+-[1-9][0-9]*\\]\\[API-[0-9]{2}\\]$" }, "testCaseId": { "type": "string" }, "operationId": { "type": "string" }, "implementationReferences": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "category": { "enum": ["positive", "negative", "boundary", "authentication", "authorization", "error-handling", "contract-validation", "schema-validation", "request-validation"] }, "summary": { "type": "string" }, "objective": { "type": "string" }, "preconditions": { "type": "array", "items": { "type": "string" } }, "sourceRequirement": { "type": "string" }, "expectedOutcome": { "type": "string" }, "action": { "type": "string" }, "data": { "type": "string" }, "expectedResult": { "type": "string" } } } },
    "automationPlan": { "type": "array", "items": { "type": "object", "required": ["operationId", "scriptName", "testCaseIds", "reusableUtilities", "testData", "environmentVariables", "requestBuilder", "contractReferences"], "properties": { "operationId": { "type": "string" }, "scriptName": { "type": "string" }, "testCaseIds": { "type": "array", "items": { "type": "string" } }, "reusableUtilities": { "type": "array", "items": { "type": "string" } }, "testData": { "type": "array", "items": { "type": "string" } }, "environmentVariables": { "type": "array", "items": { "type": "string" } }, "requestBuilder": { "type": "string" }, "contractReferences": { "type": "array", "items": { "type": "string" } } } } },
    "coverageRows": { "type": "array", "items": { "type": "object", "required": ["operationId", "method", "path", "requirementIds", "codeMapped", "testCaseIds", "automationIds", "risk", "dimensions"], "properties": { "operationId": { "type": "string" }, "method": { "type": "string" }, "path": { "type": "string" }, "requirementIds": { "type": "array", "items": { "type": "string" } }, "codeMapped": { "type": "boolean" }, "testCaseIds": { "type": "array", "items": { "type": "string" } }, "automationIds": { "type": "array", "items": { "type": "string" } }, "risk": { "enum": ["critical", "high", "medium", "low"] }, "dimensions": { "type": "object" } } } },
    "coverage": { "type": "object" },
    "gaps": { "type": "array", "items": { "type": "object", "required": ["id", "type", "operationId", "description", "recommendation", "priority"], "properties": { "id": { "type": "string" }, "type": { "enum": ["api-discovery-error", "duplicate-api-operation", "requirement-without-api", "api-without-requirement", "api-without-code", "endpoint-or-method-coverage", "high-risk-api-coverage"] }, "operationId": { "type": "string" }, "description": { "type": "string" }, "recommendation": { "type": "string" }, "priority": { "enum": ["critical", "high", "medium", "low"] } } } },
    "governance": { "type": "object", "required": ["ready", "policy", "notApplicable", "failures"], "properties": { "ready": { "type": "boolean" }, "policy": { "type": "object" }, "notApplicable": { "type": "array", "items": { "type": "string" } }, "failures": { "type": "array", "items": { "type": "string" } } } },
    "executiveMetrics": { "type": "object", "required": ["apiCoveragePercent", "contractCoveragePercent", "requirementCorrelationPercent", "implementationCoveragePercent", "riskCoveragePercent", "generatedXrayTestCount", "plannedScriptCount", "readinessScore"], "properties": { "apiCoveragePercent": { "$ref": "#/$defs/percent" }, "contractCoveragePercent": { "$ref": "#/$defs/percent" }, "requirementCorrelationPercent": { "$ref": "#/$defs/percent" }, "implementationCoveragePercent": { "$ref": "#/$defs/percent" }, "riskCoveragePercent": { "$ref": "#/$defs/percent" }, "generatedXrayTestCount": { "type": "integer", "minimum": 0 }, "plannedScriptCount": { "type": "integer", "minimum": 0 }, "readinessScore": { "$ref": "#/$defs/percent" } } }
  },
  "$defs": { "percent": { "type": "number", "minimum": 0, "maximum": 100 } }
}
